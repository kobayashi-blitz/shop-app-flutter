app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase config (per-project secrets / personal アカウントの設定 — コミットしない)
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist
# Firebase Admin SDK サービスアカウント鍵（FCM送信用・絶対にコミットしない）
*-firebase-adminsdk-*.json

# fvm (SDK 実体は ignore、.fvmrc はコミット)
.fvm/
